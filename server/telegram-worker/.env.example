# Supabase project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=
# Supabase service-role key. Keep only in Hostless secrets; never commit a real key.
SUPABASE_SERVICE_ROLE_KEY=
# Telegram API credentials from https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Telegram StringSession for a dedicated account. Keep this secret; do not use a personal
# account without understanding the security implications. Generate locally, never commit it.
TELEGRAM_SESSION=
# Polling and rate-limit controls
POLL_INTERVAL_MS=5000
BATCH_DELAY_MS=3000
PORT=8080
